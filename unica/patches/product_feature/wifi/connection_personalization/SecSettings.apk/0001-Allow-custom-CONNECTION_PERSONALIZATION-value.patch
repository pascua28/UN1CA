Subject: [PATCH] Allow custom CONNECTION_PERSONALIZATION value

---
 .../android/settings/wifi/develop/ApePreferenceController.smali | 2 +-
 .../settings/wifi/develop/compatibility/btm/BtmController.smali | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/smali_classes4/com/samsung/android/settings/wifi/develop/ApePreferenceController.smali b/smali_classes4/com/samsung/android/settings/wifi/develop/ApePreferenceController.smali
index da844d19..173811c2 100644
--- a/smali_classes4/com/samsung/android/settings/wifi/develop/ApePreferenceController.smali
+++ b/smali_classes4/com/samsung/android/settings/wifi/develop/ApePreferenceController.smali
@@ -6,7 +6,7 @@
 # static fields
 .field private static final SETTINGS_DEVELOPER_APE:Ljava/lang/String; = "sem_wifi_ape_enabled_labs"
 
-.field private static final SUPPORT_APE_SERVICE:Z = true
+.field private static final SUPPORT_APE_SERVICE:Z = false
 
 .field private static final TAG:Ljava/lang/String; = "ConfigureWifiSettings.Ape"
 
diff --git a/smali_classes4/com/samsung/android/settings/wifi/develop/compatibility/btm/BtmController.smali b/smali_classes4/com/samsung/android/settings/wifi/develop/compatibility/btm/BtmController.smali
