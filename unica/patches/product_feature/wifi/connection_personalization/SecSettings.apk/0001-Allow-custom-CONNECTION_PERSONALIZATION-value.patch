--- a/smali_classes4/com/samsung/android/settings/wifi/develop/compatibility/btm/BtmController.smali
+++ b/smali_classes4/com/samsung/android/settings/wifi/develop/compatibility/btm/BtmController.smali
@@ -25,7 +25,7 @@
 .method public getAvailabilityStatus()I
     .locals 1
 
-    const-string p0, "2"
+    const-string p0, "CONFIG_CONNECTION_PERSONALIZATION"
 
     invoke-static {p0}, Ljava/lang/Integer;->parseInt(Ljava/lang/String;)I
 
