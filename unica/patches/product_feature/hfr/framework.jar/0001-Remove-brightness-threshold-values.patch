+    .locals 4
 
     sget-object v0, Lcom/samsung/android/hardware/display/RefreshRateConfig;->sInstance:Lcom/samsung/android/hardware/display/RefreshRateConfig;
 
@@ -498,11 +498,9 @@
 
     const-string/jumbo v2, "persist.dm.passive.ambient_brightness"
 
